# Variables de Entorno — Backend SGDEA
# Copia este archivo como .env y rellena los valores reales
# NUNCA commitees el archivo .env con valores reales

# Puerto del servidor Express
PORT=3000

# Cadena de conexión a MongoDB
DB_CONNECTION_STRING=mongodb://localhost:27017/sgdea

# Secreto para firmar Access Tokens (JWT)
ACCESS_TOKEN_SECRET=

# Secreto para firmar Refresh Tokens (JWT)
REFRESH_TOKEN_SECRET=

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173
